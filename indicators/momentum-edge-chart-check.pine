//@version=6
// ============================================================
// Momentum Edge — Chart Check (Daily) — 2026-10-29 — v1.0
// Pine Script v6 | Author: skathi | Replaces ME Swing Engine + ME Regime & Quality
// ============================================================
// Purpose:   Visual confirmation layer for the daily agent dashboard. Mirrors
//            pipeline/features.py constant-for-constant (PARITY block) so the chart
//            agrees with the dashboard on the FACTS, then adds structure the scan
//            can't read (base box, prior-20 high, 52w high, bar shape).
//            It adds no independent edge: a CONFIRM means "chart and dashboard agree",
//            not a second opinion on the call.
// Regime:    US equities daily. Risk-on uptrends: squeeze -> breakout (A / b) and
//            EMA21 pullback reclaims (B). Breaks in: chop, risk-off tape, earnings
//            weeks, > 4 ATR extensions. Non-daily timeframes: draws nothing.
// Repaint:   SPY is a SAME-timeframe read: lookahead_off and NO [1] (a [1] would
//            compare stock_t with SPY_t-1). Breakout uses ta.highest(high,20)[1].
//            Markers, squeeze dots and the extension tint draw on confirmed bars only. The panel scores the last CLOSED
//            session (timenow >= time_close), or a pinned date, and prints it.
// ============================================================

indicator(
    title            = "Momentum Edge — Chart Check",
    shorttitle       = "ME Check",
    overlay          = true,
    max_bars_back    = 500,
    max_lines_count  = 20,
    max_labels_count = 20,
    max_boxes_count  = 2)

// ============================================================
// 1. PARITY — mirrors pipeline/features.py (constants :21-29)
// ============================================================
// Change pipeline/features.py FIRST, then these, in the same PR. These are
// deliberately NOT inputs: a chart that can be tuned per symbol cannot confirm
// a universe-wide scan.

const int    ATR_LEN      = 14
const int    EMA_FAST     = 9
const int    EMA_MID      = 21
const int    EMA_BASE     = 50
const int    MKT_EMA      = 50
const int    BB_LEN       = 20
const float  BB_STD       = 2.0
const float  KC_MULT      = 1.5
const int    SQZ_RECENCY  = 15
const int    BREAKOUT_LEN = 20
const int    PULL_LOOK    = 8
const int    PULL_SLOPE   = 10
const float  PULL_TOL_ATR = 0.5
const float  BODY_ATR     = 0.5
const int    VOL_MA       = 20
const float  VOL_SURGE    = 1.3
const float  MAX_EXT_ATR  = 4.0
const int    RS_EMA       = 20
const int    RS_RISING    = 5
const int    BASE_LEN     = 15
const int    YEAR_BARS    = 252
const int    EARN_MIN     = 4       // publish rejects candidates with earnings < 4 sessions away
const float  NEAR_TIGHT   = 1.0     // post-squeeze counts when the prior-20 high is within 1 ATR
const int    SMA_MID      = 50
const int    SMA_LONG     = 200
const int    SMA_RISE     = 20      // sma200_rising: SMA200 above its value 20 bars ago
const float  NEAR_52W_ATR = 2.0     // pipeline tag near_52w_high
const int    PIN_BUFFER   = 499     // max_bars_back - 1: deepest pinnable offset
const string BENCH        = "AMEX:SPY"

// ============================================================
// 2. INPUTS — dashboard hand-off + display only (none affect signals)
// ============================================================

i_pinAsOf   = input.bool(false,   "Pin to dashboard date",       group="Dashboard Hand-off",
     tooltip="Off: score the last closed session. On: score the date below (the dashboard's as_of).")
i_asOfStr   = input.string("",    "Dashboard as_of (YYYY-MM-DD)", group="Dashboard Hand-off")
i_stopAtr   = input.float(2.0,    "Stop (ATR)",                  minval=1.0, maxval=4.0, step=0.25, group="Dashboard Hand-off")
i_chaseAtr  = input.float(0.5,    "Max chase (ATR)",             minval=0.0, maxval=2.0, step=0.25, group="Dashboard Hand-off")
i_tgt1R     = input.float(2.0,    "Target 1 (R)",                minval=0.0, maxval=10.0, step=0.5, group="Dashboard Hand-off")
i_tgt2R     = input.float(4.0,    "Target 2 (R, 0 = off)",       minval=0.0, maxval=10.0, step=0.5, group="Dashboard Hand-off")
i_horizon   = input.int(20,       "Horizon (sessions)",          minval=5,   maxval=60,             group="Dashboard Hand-off")

i_showEmas  = input.bool(true,    "Show EMA 9/21/50 + SMA200",                                      group="Display")
i_showStruc = input.bool(true,    "Show structure (prior-20 high, 52w high, base box)",             group="Display")
i_showLvls  = input.bool(true,    "Show levels (stop / chase / targets)",                           group="Display")
i_showPanel = input.bool(true,    "Show panel",                                                     group="Display")
i_nearPct   = input.float(5.0,    "Borderline band (%)",         minval=0.0, maxval=25.0, step=1.0, group="Display")

// ============================================================
// 3. FEATURES — one line per features.py definition
// ============================================================

isDaily  = timeframe.isdaily and timeframe.multiplier == 1

atr      = ta.atr(ATR_LEN)                                  // Wilder, as atr_wilder()
emaFast  = ta.ema(close, EMA_FAST)
emaMid   = ta.ema(close, EMA_MID)
emaBase  = ta.ema(close, EMA_BASE)
sma50    = ta.sma(close, SMA_MID)
sma200   = ta.sma(close, SMA_LONG)

// Squeeze: shared SMA20 basis, population stdev, upper band only (features.py:154-158).
squeeze     = BB_STD * ta.stdev(close, BB_LEN) <= KC_MULT * atr
barsSinceSq = ta.barssince(squeeze)
postSqueeze = not na(barsSinceSq) and barsSinceSq <= SQZ_RECENCY - 1     // bars 0..14

prior20High = ta.highest(high, BREAKOUT_LEN)[1]
breakout    = close > prior20High
hi52        = ta.highest(high, math.min(YEAR_BARS, bar_index + 1))

// Pullback reclaim (features.py:167-170). The touch uses the CURRENT ATR for all 8 bars, as Python does.
ema21Rising  = emaMid > emaMid[PULL_SLOPE]
touched      = ta.lowest(low - emaMid, PULL_LOOK) <= PULL_TOL_ATR * atr
reclaimToday = close > emaMid and (close - open) >= BODY_ATR * atr
pullback     = ema21Rising and touched and reclaimToday and emaMid > emaBase

volMa    = ta.sma(volume, VOL_MA)
volRatio = volume / volMa
volSurge = volume >= VOL_SURGE * volMa                     // same form as features.py (boundary-exact)

extAtr       = (close - emaMid) / atr
extended     = extAtr > MAX_EXT_ATR
trendStack   = close > emaBase and emaMid > emaBase and (na(sma200) or sma50 > sma200)
sma200Rising = sma200 > sma200[SMA_RISE]
dist52Atr    = (hi52 - close) / atr
priorHiAtr   = (prior20High - close) / atr
baseHigh     = ta.highest(high, BASE_LEN)
baseLow      = ta.lowest(low, BASE_LEN)
baseRangeAtr = (baseHigh - baseLow) / atr

// SPY: SAME-timeframe read, no [1] (pine-v6-patterns §1b). The EMA is computed on SPY's own bars.
[spyClose, spyEma, spyEma5] = request.security(BENCH, timeframe.period,
     [close, ta.ema(close, MKT_EMA), ta.ema(close, MKT_EMA)[5]], lookahead=barmerge.lookahead_off)
riskOn   = spyClose > spyEma and spyEma > spyEma5
rsLine   = spyClose > 0 ? close / spyClose : na
rsEma    = ta.ema(rsLine, RS_EMA)
rsRising = rsEma > rsEma[RS_RISING]

// Setups, exactly as the pipeline's tags (ungated: the gates live in the panel).
setupA = breakout and postSqueeze
setupb = breakout and not postSqueeze
setupB = pullback

// ============================================================
// 4. AS-OF BAR — which session the panel scores
// ============================================================
// Auto: the last bar counts only once its session has ended (timenow >= time_close);
// before that, score the previous bar. Pinned: the last bar whose date <= the input date.

f_dayKey(int t) =>
    year(t, syminfo.timezone) * 10000 + month(t, syminfo.timezone) * 100 + dayofmonth(t, syminfo.timezone)

f_parseKey(string s) =>
    parts = str.split(str.trim(s), "-")
    array.size(parts) == 3 ? int(str.tonumber(array.get(parts, 0)) * 10000 + str.tonumber(array.get(parts, 1)) * 100 + str.tonumber(array.get(parts, 2))) : na

pinKey = f_parseKey(i_asOfStr)
pinned = i_pinAsOf and not na(pinKey)
var int pinIdx = na
if pinned and f_dayKey(time) <= pinKey
    pinIdx := bar_index

liveOff   = barstate.islast and timenow < time_close ? 1 : 0
pinRaw    = pinned and not na(pinIdx) ? bar_index - pinIdx : na
pinMissed = pinned and na(pinIdx)                           // pin date before chart history
pinTooOld = not na(pinRaw) and pinRaw > PIN_BUFFER
// Never score the forming bar, even when the pin is today or later; never exceed the buffer.
off       = not na(pinRaw) and not pinTooOld ? math.max(pinRaw, liveOff) : liveOff
pinOk     = pinned and not pinMissed and not pinTooOld

// ============================================================
// 5. PLOTS
// ============================================================

C_GOOD = color.new(#12733a, 0)
C_WARN = color.new(#b07800, 0)
C_BAD  = color.new(#b3261e, 0)
C_MUTE = color.new(#8a919e, 0)
C_ACC  = color.new(#2456c9, 0)

plot(isDaily and i_showEmas ? emaFast : na, "EMA 9",   color=color.new(#8fa8ff, 0), linewidth=1)
plot(isDaily and i_showEmas ? emaMid  : na, "EMA 21",  color=C_ACC,                linewidth=2)
plot(isDaily and i_showEmas ? emaBase : na, "EMA 50",  color=color.new(#e08a00, 0), linewidth=2)
plot(isDaily and i_showEmas ? sma200  : na, "SMA 200", color=C_MUTE,               linewidth=1)
plot(isDaily and i_showStruc ? prior20High : na, "Prior 20-bar high", color=color.new(#5f6775, 30), style=plot.style_stepline)
plot(isDaily and i_showStruc ? hi52 : na,        "52-week high",      color=color.new(#12733a, 50), style=plot.style_circles, linewidth=1)

plotshape(isDaily and barstate.isconfirmed and squeeze, "Squeeze", shape.circle, location.belowbar, color.new(#b07800, 20), size=size.tiny)

// Filled = volume >= 1.3x; faded = below. Grey = trend stack failed on that bar.
f_markerColor(bool surge, bool stack) =>
    base = stack ? C_GOOD : C_MUTE
    surge ? base : color.new(base, 65)

plotshape(isDaily and barstate.isconfirmed and setupA, "Setup A (squeeze breakout)", shape.labelup, location.belowbar,
     f_markerColor(volSurge, trendStack), text="A", textcolor=color.white, size=size.small)
plotshape(isDaily and barstate.isconfirmed and setupb, "Setup b (breakout, no squeeze)", shape.labelup, location.belowbar,
     f_markerColor(volSurge, trendStack), text="b", textcolor=color.white, size=size.tiny)
plotshape(isDaily and barstate.isconfirmed and setupB, "Setup B (pullback reclaim)", shape.labelup, location.belowbar,
     color.new(trendStack ? C_ACC : C_MUTE, volSurge ? 0 : 65), text="B", textcolor=color.white, size=size.small)

bgcolor(isDaily and barstate.isconfirmed and extended ? color.new(#b3261e, 90) : na, title="Extended > 4 ATR")

// Hidden series for alert messages ({{plot("...")}}).
plot(extAtr,   "Ext ATR",   display=display.none)
plot(volRatio, "Vol ratio", display=display.none)

// ============================================================
// 6. AS-OF SNAPSHOT, LEVELS, BASE BOX (last bar only)
// ============================================================

f_dayStart(int t) =>
    timestamp(syminfo.timezone, year(t, syminfo.timezone), month(t, syminfo.timezone), dayofmonth(t, syminfo.timezone), 0, 0)

f_weekdaysBetween(int fromT, int toT) =>
    // Weekdays in (from, to] counted on calendar dates in the exchange timezone, as
    // daily.weekdays_between() does (holidays ignored: a slight overcount, the safe side).
    int n = 0
    int a = na(fromT) ? na : f_dayStart(fromT)
    int b = na(toT) ? na : f_dayStart(toT)
    if not na(a) and not na(b) and b > a
        int days = math.min(int(math.round((b - a) / 86400000.0)), 400)
        for i = 1 to math.max(days, 1)   // Pine's `1 to 0` counts DOWN; days >= 1 here anyway
            if i > days
                break
            int d = dayofweek(fromT + i * 86400000, syminfo.timezone)
            if d != dayofweek.saturday and d != dayofweek.sunday
                n += 1
    n

var box  baseBox = na
var line[] lvlLines = array.new<line>()
var label[] lvlLabels = array.new<label>()
var float stopPinned = na

if isDaily and barstate.islast
    refClose = close[off]
    refAtr   = atr[off]
    stopLvl  = refClose - i_stopAtr * refAtr
    risk     = refClose - stopLvl
    stopPinned := pinOk ? stopLvl : na

    box.delete(baseBox)
    if i_showStruc
        baseBox := box.new(bar_index - off - (BASE_LEN - 1), baseHigh[off], bar_index - off, baseLow[off], border_color=color.new(#5f6775, 40), bgcolor=color.new(#5f6775, 92),
             text=str.format("base {0,number,#.#} ATR", baseRangeAtr[off]), text_size=size.tiny,
             text_valign=text.align_top, text_halign=text.align_left, text_color=C_MUTE)

    for l in lvlLines
        line.delete(l)
    for lb in lvlLabels
        label.delete(lb)
    array.clear(lvlLines)
    array.clear(lvlLabels)
    if i_showLvls
        x1 = bar_index - off
        x2 = bar_index + 8
        lvls = array.from(refClose, refClose + i_chaseAtr * refAtr, stopLvl, refClose + i_tgt1R * risk, i_tgt2R > 0 ? refClose + i_tgt2R * risk : na)
        names = array.from("ref close", "buy up to", "stop " + str.tostring(i_stopAtr) + " ATR", str.tostring(i_tgt1R) + "R", str.tostring(i_tgt2R) + "R")
        cols = array.from(C_MUTE, C_ACC, C_BAD, C_GOOD, C_GOOD)
        for i = 0 to array.size(lvls) - 1
            p = array.get(lvls, i)
            if i_tgt1R == 0 and i == 3
                continue
            if not na(p)
                array.push(lvlLines, line.new(x1, p, x2, p, color=array.get(cols, i), style=i == 0 ? line.style_dotted : line.style_dashed))
                array.push(lvlLabels, label.new(x2, p, str.format("{0} {1,number,#.##}", array.get(names, i), p),
                     style=label.style_label_left, color=color.new(color.white, 100), textcolor=array.get(cols, i), size=size.tiny))
        // Horizon marker: the last session of the hold.
        array.push(lvlLines, line.new(x1 + i_horizon, refClose - 0.5 * refAtr, x1 + i_horizon, refClose + 0.5 * refAtr,
             color=color.new(#5f6775, 30), width=2))

// ============================================================
// 7. PANEL — scores the as-of bar, prints its date
// ============================================================

f_near(float v, float thr) =>
    // Within i_nearPct of a threshold: the vendor-volume / late-print danger zone.
    not na(v) and thr != 0 and math.abs(v - thr) / math.abs(thr) * 100.0 <= i_nearPct

var table panel = table.new(position.top_right, 2, 13, bgcolor=color.new(#171a21, 8), border_width=0, frame_color=color.new(#2a2f3a, 0), frame_width=1)

f_row(int r, string k, string v, color c) =>
    table.cell(panel, 0, r, k, text_color=color.new(#9aa2b1, 0), text_size=size.small, text_halign=text.align_left)
    table.cell(panel, 1, r, v, text_color=c, text_size=size.small, text_halign=text.align_right)

if barstate.islast and i_showPanel
    table.clear(panel, 0, 0, 1, 12)
    if not isDaily
        f_row(0, "ME Check", "Daily timeframe required", C_WARN)
    else
        asOfT     = time[off]
        earnT     = earnings.future_time
        earnSess  = na(earnT) ? na : f_weekdaysBetween(asOfT, int(earnT))
        earnSoon  = not na(earnSess) and earnSess < EARN_MIN
        cRisk     = riskOn[off]
        cStack    = trendStack[off]
        cRs       = rsRising[off]
        cExt      = extAtr[off]
        cVol      = volRatio[off]
        cA        = setupA[off]
        cB        = setupB[off]
        cBo       = breakout[off]
        cPost     = postSqueeze[off]
        cPrHi     = priorHiAtr[off]
        cSurge    = volSurge[off]
        // A breakout needs volume; post-squeeze only counts BEFORE the breakout (coiled under the high).
        hasSetup  = (cBo and cSurge) or cB or (not cBo and cPost and cPrHi <= NEAR_TIGHT)
        closedC   = close[liveOff]                               // last closed session, never the forming bar
        belowStop = pinOk and closedC < stopPinned

        string reason = ""
        string verdict = "CONFIRM"
        if close[off] < emaBase[off]
            verdict := "AVOID"
            reason  := "below EMA50"
        else if cExt > MAX_EXT_ATR
            verdict := "AVOID"
            reason  := "extended > 4 ATR"
        else if earnSoon
            verdict := "AVOID"
            reason  := "earnings < 4 sessions"
        else if belowStop
            verdict := "AVOID"
            reason  := "closed below stop"
        else if not cRisk
            verdict := "CAUTION"
            reason  := "SPY gate off"
        else if not cStack
            verdict := "CAUTION"
            reason  := "trend not stacked"
        else if not cRs
            verdict := "CAUTION"
            reason  := "RS not rising"
        else if not hasSetup
            verdict := "CAUTION"
            reason  := cBo ? "breakout on low volume" : "no setup today"
        vColor = verdict == "CONFIRM" ? C_GOOD : verdict == "AVOID" ? C_BAD : C_WARN

        setupTxt = cA ? "A squeeze breakout" : cBo ? "b breakout" : cB ? "B pullback reclaim" :
             cPost ? str.format("post-squeeze ({0} bars)", barsSinceSq[off]) : squeeze[off] ? "in squeeze" : "none"

        header = str.format("as of {0}", str.format_time(asOfT, "yyyy-MM-dd", syminfo.timezone))
        if pinMissed
            f_row(0, header, "pin date not on chart: auto", C_WARN)
        else if pinTooOld
            f_row(0, header, "pin older than 500 bars: auto", C_WARN)
        else
            f_row(0, header, verdict + (reason != "" ? " · " + reason : ""), vColor)
        f_row(1,  "SPY gate",     cRisk ? "risk-on" : "off", cRisk ? C_GOOD : C_WARN)
        f_row(2,  "Trend stack",  (cStack ? "yes" : "no") + (sma200Rising[off] ? " · 200d rising" : " · 200d flat"), cStack ? C_GOOD : C_WARN)
        f_row(3,  "RS vs SPY",    cRs ? "rising" : "not rising", cRs ? C_GOOD : C_WARN)
        f_row(4,  "Setup",        setupTxt, cA or cBo or cB ? C_GOOD : C_MUTE)
        f_row(5,  "Volume",       str.format("{0,number,#.##}x", cVol), f_near(cVol, VOL_SURGE) ? C_WARN : cVol >= VOL_SURGE ? C_GOOD : C_MUTE)
        f_row(6,  "Extension",    str.format("{0,number,#.#} ATR vs EMA21", cExt), cExt > MAX_EXT_ATR ? C_BAD : f_near(cExt, MAX_EXT_ATR) ? C_WARN : C_GOOD)
        f_row(7,  "To prior-20 high", str.format("{0,number,#.##} ATR", cPrHi), cPrHi <= NEAR_TIGHT ? C_GOOD : C_MUTE)
        f_row(8,  "To 52w high",  str.format("{0,number,#.#} ATR", dist52Atr[off]), dist52Atr[off] <= NEAR_52W_ATR ? C_GOOD : C_MUTE)
        f_row(9,  "Base (15d)",   str.format("{0,number,#.#} ATR range", baseRangeAtr[off]), C_MUTE)
        f_row(10, "ATR",          str.format("{0,number,#.##}% of price", 100 * atr[off] / close[off]), C_MUTE)
        f_row(11, "Next earnings", na(earnSess) ? "no date (TV)" : str.format("{0} · ~{1} sess (TV, from today)",
             str.format_time(int(earnT), "MMM d", syminfo.timezone), earnSess),
             earnSoon ? C_BAD : not na(earnSess) and earnSess <= i_horizon ? C_WARN : C_MUTE)
        f_row(12, "Levels",       pinOk ? str.format("pinned · stop {0} ATR", i_stopAtr) : "auto (pin to match dashboard)", pinOk ? C_ACC : C_MUTE)

// ============================================================
// 8. ALERTS — confirmed bars only, with context
// ============================================================

avoidCore = close < emaBase or extended

// Setup alerts carry the same context the panel's CONFIRM needs: SPY gate, trend stack,
// not extended; an A also needs volume. The raw markers stay on the chart either way.
ctxOk = riskOn and trendStack and not extended
alertcondition(isDaily and barstate.isconfirmed and setupA and volSurge and ctxOk,
     title="ME Check: A squeeze breakout (in context)",
     message='{{ticker}} A squeeze breakout @ {{close}} | ext {{plot("Ext ATR")}} ATR | vol x{{plot("Vol ratio")}}')
alertcondition(isDaily and barstate.isconfirmed and setupB and ctxOk,
     title="ME Check: B pullback reclaim (in context)",
     message='{{ticker}} B pullback reclaim @ {{close}} | ext {{plot("Ext ATR")}} ATR | vol x{{plot("Vol ratio")}}')
alertcondition(isDaily and barstate.isconfirmed and not na(stopPinned) and close < stopPinned,
     title="ME Check: close below pinned stop",
     message="{{ticker}} CLOSED {{close}} below the pinned dashboard stop (close-based, like the dashboard's invalidation)")
alertcondition(isDaily and barstate.isconfirmed and avoidCore and not avoidCore[1],
     title="ME Check: turned AVOID", message="{{ticker}} turned AVOID @ {{close}} (below EMA50 or > 4 ATR extended)")

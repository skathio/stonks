# Template — copy to `.env` in this folder and fill in. `.env` is gitignored.
# probe.py loads `.env` automatically; values already exported in your shell win.

# https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=

# https://massive.com -> dashboard -> API Keys (free "Basic" plan)
MASSIVE_API_KEY=

# https://finnhub.io/register -> key shown on dashboard
FINNHUB_API_KEY=

# SEC fair-access policy wants a real contact: Your Name you@example.com
SEC_USER_AGENT=
